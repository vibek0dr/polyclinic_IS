<Window x:Class="poliklinika.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рабочее место врача" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"    Icon="pack://application:,,,/images/pol.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1A2530" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поликлиника" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text=" / Рабочее место врача" Foreground="#A0AAB5" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TbDoctorName" Text="Иванов И.И." Foreground="#A0AAB5" FontSize="14" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnLogout" Content="Выйти" Width="100" Click="BtnLogout_Click" Background="#E76F51"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая карточка (Список) -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock Text="Мои пациенты" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" 
                               Foreground="#1A2530" Margin="0,0,0,15"/>
                    <DataGrid x:Name="DgAppointments" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionChanged="DgAppointments_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="80"/>
                            <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Правая карточка (Карточка приема) -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="25">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Карточка приема" FontSize="18" FontWeight="Bold" 
                               Foreground="#1A2530" Margin="0,0,0,20"/>

                    <TextBlock Text="Жалобы:" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                    <TextBox x:Name="TbComplaints" Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" Padding="10" VerticalContentAlignment="Top"/>

                    <TextBlock Text="Диагноз:" FontSize="13" Foreground="#4A5568" Margin="0,15,0,5"/>
                    <TextBox x:Name="TbDiagnosis" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" Padding="10" VerticalContentAlignment="Top"/>

                    <TextBlock Text="Назначения:" FontSize="13" Foreground="#4A5568" Margin="0,15,0,5"/>
                    <TextBox x:Name="TbPrescriptions" Height="100" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" Padding="10" VerticalContentAlignment="Top"/>

                    <Button x:Name="BtnSaveRecord" Content="Сохранить результаты" Width="200" 
                            HorizontalAlignment="Left" Margin="0,20,0,0" Click="BtnSaveRecord_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>