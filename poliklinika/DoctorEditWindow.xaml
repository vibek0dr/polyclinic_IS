<Window x:Class="poliklinika.DoctorEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление врача" Height="876" Width="450"
       WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"     Icon="pack://application:,,,/images/pol.ico">
    <Grid>
        <Border Background="White" Width="380" Padding="30" CornerRadius="15" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <!-- Скрытое поле для ID (если редактируем) -->
                <TextBlock x:Name="TbId" Visibility="Collapsed"/>

                <TextBlock Text="Данные врача" FontSize="20" FontWeight="Bold" 
               Foreground="#1A2530" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Фамилия" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbLastName" Margin="0,0,0,10"/>

                <TextBlock Text="Имя" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbFirstName" Margin="0,0,0,10"/>

                <TextBlock Text="Отчество" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbMiddleName" Margin="0,0,0,10"/>

                <TextBlock Text="Специализация" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbSpecialization" DisplayMemberPath="Nazvanie_specializacii" 
              SelectedValuePath="Kod_specializacii" Margin="0,0,0,10"/>

                <TextBlock Text="Кабинет" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbRoom" Margin="0,0,0,10"/>

                <TextBlock Text="Телефон" FontSize="13" Foreground="#4A5568" Margin="0,0,0,10"/>
                <TextBox x:Name="TbPhone" Margin="0,0,0,10"/>

                <TextBlock Text="Логин" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbLogin" Margin="0,0,0,10"/>

                <TextBlock Text="Пароль" FontSize="13" Foreground="#4A5568" Margin="0,0,0,20"/>
                <TextBox x:Name="TbPassword" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnSave" Content="Сохранить" Width="140" Margin="0,0,15,0" Background="#2A9D8F" Click="BtnSave_Click"/>
                    <Button Content="Отмена" Width="140" Background="#E76F51" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>