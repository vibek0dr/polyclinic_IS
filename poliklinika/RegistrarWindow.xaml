<Window x:Class="poliklinika.RegistrarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистратура" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"    Icon="pack://application:,,,/images/pol.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1A2530" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поликлиника / Регистратура" Foreground="White" FontSize="20" 
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnLogout" Content="Выйти" Width="100" HorizontalAlignment="Right" 
                        VerticalAlignment="Center" Click="BtnLogout_Click" Background="#E76F51"/>
            </Grid>
        </Border>

        <!-- Панель управления -->
        <Border Grid.Row="1" Background="White" Margin="20,20,20,10" Padding="15" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Дата приема:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4A5568"/>
                <DatePicker Grid.Column="1" x:Name="DpDate" Width="150" SelectedDateChanged="DpDate_SelectedDateChanged"/>

                <TextBlock Grid.Column="2" Text="Врач:" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="#4A5568"/>
                <ComboBox Grid.Column="3" x:Name="CbDoctors" Width="250" HorizontalAlignment="Left" 
                          DisplayMemberPath="Fio" SelectedValuePath="Kod_vracha" SelectionChanged="CbDoctors_SelectionChanged"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="TbSearch" Width="106" Height="32" Margin="0,0,10,0" Padding="5,0" 
             VerticalContentAlignment="Center" ToolTip="Поиск по ФИО пациента" TextChanged="TbSearch_TextChanged"/>
                    <Button x:Name="BtnSearch" Content="Найти" Width="70" Height="32" Background="#2A9D8F" Click="BtnSearch_Click"/>

                    <Button x:Name="BtnAddPatient" Content="Добавить пациента" Width="150" Height="32" Background="#3498DB" 
            Margin="10,0,0,0" Click="BtnAddPatient_Click"/>

                    <Button x:Name="BtnAdd" Content="Записать" Width="100" Height="32" Background="#2A9D8F" 
            Margin="10,0,0,0" Click="BtnAdd_Click"/>
                    <Button x:Name="BtnAddTime" Content="Добавить время" Width="140" Height="32" Background="#3498DB" 
            Margin="10,0,0,0" Click="BtnAddTime_Click"/>
                    <Button x:Name="BtnCancelAppointment" Content="Отменить" Width="100" Height="32" Background="#E76F51" 
            Margin="10,0,0,0" Click="BtnCancelAppointment_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент: Таблица и Фото -->
        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
                </Border.Effect>
                <DataGrid x:Name="DgSchedule" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="DgSchedule_SelectionChanged" 
                          MouseDoubleClick="DgSchedule_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="100"/>
                        <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="*"/>
                        <DataGridTextColumn Header="Кабинет" Binding="{Binding Room}" Width="100"/>
                        <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Блок с фото услуги -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Услуга" FontSize="16" FontWeight="Bold" Foreground="#1A2530" 
                               HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Картинка -->
                    <Border Background="#F8F9FA" CornerRadius="8" Height="200" Margin="0,0,0,15">
                        <Image x:Name="ImgService" Stretch="Uniform" Margin="5"/>
                    </Border>

                    <!-- Название услуги -->
                    <TextBlock x:Name="TbServiceName" Text="Выберите запись" FontSize="14" 
                               Foreground="#4A5568" HorizontalAlignment="Center" TextWrapping="Wrap" 
                               TextAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>