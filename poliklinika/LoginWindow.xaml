<Window x:Class="poliklinika.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#E8F0F2"     Icon="pack://application:,,,/images/pol.ico">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D8E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D8E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

      
        <Style TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A9D8F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21867A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Основной фон с градиентом -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A2530" Offset="0.0"/>
                <GradientStop Color="#2A4B5C" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Карточка по центру -->
        <Border Background="White" Width="400" Padding="40" CornerRadius="15" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Поликлиника" FontSize="32" FontWeight="Bold" 
                           Foreground="#1A2530" HorizontalAlignment="Center"/>
                <TextBlock Text="Вход в систему" FontSize="14" Foreground="#6B7B8D" 
                           HorizontalAlignment="Center" Margin="0,5,0,30"/>

                <!-- Поля -->
                <TextBlock Text="Логин" FontSize="13" Foreground="#4A5568" Margin="0,0,0,8"/>
                <TextBox x:Name="TbLogin"/>

                <TextBlock Text="Пароль" FontSize="13" Foreground="#4A5568" Margin="0,20,0,8"/>
                <PasswordBox x:Name="PbPassword"/>

                <!-- Ошибка -->
                <TextBlock x:Name="TbError" Text="" Foreground="#E76F51" FontSize="12" 
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,10"/>

                <!-- Кнопка -->
                <Button x:Name="BtnLogin" Content="Войти" Click="BtnLogin_Click" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>