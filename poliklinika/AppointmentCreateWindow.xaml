<Window x:Class="poliklinika.AppointmentCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись на прием" Height="600" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">

    <Grid>
        <Border Background="White" Width="400" Padding="30" CornerRadius="15" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Новая запись" FontSize="24" FontWeight="Bold" 
                           Foreground="#1A2530" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Пациент -->
                <TextBlock Text="Пациент" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbPatients" Margin="0,0,0,15" 
                          DisplayMemberPath="Fio" SelectedValuePath="Kod_pacienta"/>

                <!-- Услуга -->
                <TextBlock Text="Услуга" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbServices" Margin="0,0,0,15" 
                          DisplayMemberPath="Nazvanie" SelectedValuePath="Kod_uslugi"/>

                <!-- Врач -->
                <TextBlock Text="Врач" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbDoctors" Margin="0,0,0,15" 
                          DisplayMemberPath="Fio" SelectedValuePath="Kod_vracha" 
                          SelectionChanged="CbDoctors_SelectionChanged"/>

                <!-- Время -->
                <TextBlock Text="Свободное время" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbTimeSlots" Margin="0,0,0,25" 
                          DisplayMemberPath="Time" SelectedValuePath="Kod_slota"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnBook" Content="Записать" Width="140" Margin="0,0,15,0" 
                            Background="#2A9D8F" Click="BtnBook_Click"/>
                    <Button x:Name="BtnCancel" Content="Отмена" Width="140" 
                            Background="#E76F51" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>