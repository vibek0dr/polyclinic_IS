<Window x:Class="poliklinika.PatientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка пациента" Height="855" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"     Icon="pack://application:,,,/images/pol.ico">

    <Grid Margin="0,0,0,16">
        <Border Background="White" Width="400" Padding="30" CornerRadius="15" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock x:Name="TbTitle" Text="Новый пациент" FontSize="24" FontWeight="Bold" 
                           Foreground="#1A2530" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Фамилия -->
                <TextBlock Text="Фамилия" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbLastName" Margin="0,0,0,10"/>

                <!-- Имя -->
                <TextBlock Text="Имя" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbFirstName" Margin="0,0,0,10"/>

                <!-- Отчество -->
                <TextBlock Text="Отчество" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbMiddleName" Margin="0,0,0,10"/>

                <!-- Дата рождения -->
                <TextBlock Text="Дата рождения" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <DatePicker x:Name="DpBirthDate" Margin="0,0,0,10"/>

                <!-- Пол -->
                <TextBlock Text="Пол" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbGender" Margin="0,0,0,10">
                    <ComboBoxItem Content="М"/>
                    <ComboBoxItem Content="Ж"/>
                </ComboBox>

                <!-- Полис -->
                <TextBlock Text="Номер полиса" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbPolicy" Margin="0,0,0,10" MaxLength="16"/>

                <!-- Адрес -->
                <TextBlock Text="Адрес" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbAddress" Margin="0,0,0,10"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон" FontSize="13" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TbPhone" Margin="0,0,0,25"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnSave" Content="Сохранить" Width="140" Margin="0,0,15,0" 
                            Background="#2A9D8F" Click="BtnSave_Click"/>
                    <Button x:Name="BtnCancel" Content="Отмена" Width="140" 
                            Background="#E76F51" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>